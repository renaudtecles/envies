{
  "manifest_version": 3,
  "name": "Envies — liste d'achats",
  "short_name": "Envies",
  "version": "1.0.0",
  "description": "Garde tes futurs achats au même endroit : lien, prix relevé automatiquement, catégorie.",
  "action": {
    "default_title": "Envies",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "contextMenus", "favicon"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+E", "mac": "Alt+Shift+E" },
      "description": "Ouvrir Envies"
    }
  }
}
